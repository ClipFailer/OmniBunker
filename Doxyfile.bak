# ============================================================================
# Doxygen configuration for Unreal Engine C++ project
# ============================================================================

PROJECT_NAME           = "OmniBunker UE5 C++ Проект"
PROJECT_BRIEF          = "Документация исходного кода проекта"
PROJECT_NUMBER         = "1.0"

# ----------------------------------------------------------------------------
# INPUT
# ----------------------------------------------------------------------------

# Явно указываем папку Source (относительно расположения Doxyfile)
INPUT                  = ./Source
RECURSIVE              = YES

FILE_PATTERNS          = *.h \
                         *.hpp \
                         *.cpp \
                         *.cc \
                         *.cxx

# Исключаем временные и служебные папки Unreal Engine
EXCLUDE_PATTERNS       = */Binaries/* \
                         */Build/* \
                         */Intermediate/* \
                         */Saved/* \
                         */DerivedDataCache/* \
                         */.git/* \
                         */docs/* \
                         */ThirdParty/*

# ----------------------------------------------------------------------------
# PARSING
# ----------------------------------------------------------------------------

EXTENSION_MAPPING      = h=C++ \
                         hpp=C++ \
                         cpp=C++ \
                         cc=C++ \
                         cxx=C++

OPTIMIZE_OUTPUT_FOR_C  = NO
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = YES
EXTRACT_LOCAL_METHODS  = YES

HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
HIDE_UNDOC_RELATIONS   = NO

# Unreal Engine macros
PREDEFINED             = UCLASS(...) \
                         USTRUCT(...) \
                         UENUM(...) \
                         UPROPERTY(...) \
                         UFUNCTION(...) \
                         UINTERFACE(...) \
                         GENERATED_BODY(...) \
                         GENERATED_UCLASS_BODY(...) \
                         GENERATED_USTRUCT_BODY(...) \
                         GENERATED_UENUM_BODY(...) \
                         UE_API= \
                         FORCEINLINE=inline \
                         DEFINE_LOG_CATEGORY_STATIC(...)= \
                         DEFINE_LOG_CATEGORY(...)= \
                         DECLARE_LOG_CATEGORY_EXTERN(...)= \
                         UE_NODISCARD= \
                         FUNC_DECL= \
                         VIRTUAL=

MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = NO

# ----------------------------------------------------------------------------
# COMMENTS / LANGUAGE
# ----------------------------------------------------------------------------

OUTPUT_LANGUAGE        = Russian

JAVADOC_AUTOBRIEF      = YES
QT_AUTOBRIEF           = YES
MULTILINE_CPP_IS_BRIEF = NO

# UTF-8
INPUT_ENCODING         = UTF-8
OUTPUT_TEXT_DIRECTION  = None

# ----------------------------------------------------------------------------
# WARNINGS
# ----------------------------------------------------------------------------

WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = NO      # Не ругаться на недокументированный код
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = NO
WARN_AS_ERROR          = NO

# ----------------------------------------------------------------------------
# HTML
# ----------------------------------------------------------------------------

GENERATE_HTML          = YES
HTML_OUTPUT            = docs/html

HTML_TIMESTAMP         = NO
HTML_DYNAMIC_MENUS     = YES
GENERATE_TREEVIEW      = YES
FULL_SIDEBAR           = YES
DISABLE_INDEX          = NO
ENUM_VALUES_PER_LINE   = 4

SEARCHENGINE           = YES
SERVER_BASED_SEARCH    = NO

HTML_COLORSTYLE        = LIGHT

HTML_EXTRA_STYLESHEET  = doxygen.css

GENERATE_HTMLHELP      = NO
GENERATE_CHI           = NO
GENERATE_ECLIPSEHELP   = NO
GENERATE_QHP           = NO
GENERATE_DOCSET        = NO

# ----------------------------------------------------------------------------
# NAVIGATION / SORTING
# ----------------------------------------------------------------------------

SORT_MEMBER_DOCS       = NO
SORT_BRIEF_DOCS        = NO
SORT_MEMBERS_CTORS_1ST = YES
SORT_GROUP_NAMES       = NO
SORT_BY_SCOPE_NAME     = YES

# ----------------------------------------------------------------------------
# GRAPHS (requires Graphviz)
# ----------------------------------------------------------------------------

HAVE_DOT               = YES

# Настройки графов
CLASS_GRAPH            = YES
COLLABORATION_GRAPH    = YES
GROUP_GRAPHS           = YES
UML_LOOK               = YES
CALL_GRAPH             = NO      # Отключаем для скорости
CALLER_GRAPH           = NO      # Отключаем для скорости
DOT_IMAGE_FORMAT       = svg
INTERACTIVE_SVG        = YES

# Если графы не нужны, замените HAVE_DOT = NO

# ----------------------------------------------------------------------------
# LATEX / OTHER OUTPUT
# ----------------------------------------------------------------------------

GENERATE_LATEX         = NO
GENERATE_RTF           = NO
GENERATE_MAN           = NO
GENERATE_XML           = NO

# ----------------------------------------------------------------------------
# FILES
# ----------------------------------------------------------------------------

CREATE_SUBDIRS         = NO
DIRECTORY_GRAPH        = YES
SHOW_FILES             = YES
SHOW_NAMESPACES        = YES

# ----------------------------------------------------------------------------
# SOURCE BROWSER
# ----------------------------------------------------------------------------

SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
STRIP_CODE_COMMENTS    = NO
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES

# ----------------------------------------------------------------------------
# HTML footer/header
# ----------------------------------------------------------------------------

HTML_HEADER            =
HTML_FOOTER            =
HTML_EXTRA_FILES       =