HIDE_UNDOC_CLASSES     = NO
HIDE_UNDOC_RELATIONS   = NO

# ----------------------------------------------------------------------------
# MACROS (Unreal Engine support)
#
# Правила:
#   1. UE-макросы с аргументами разворачиваем в пустоту — парсер их не понимает.
#   2. GENERATED_BODY и его варианты — тоже в пустоту.
#   3. Шаблонные контейнеры (TArray, TMap и т.д.) заменяем на стандартные
#      аналоги, иначе Doxygen ломается на угловых скобках после пустой замены.
#   4. Базовые классы UE (AActor, UObject и т.д.) НЕ трогаем — пусть
#      Doxygen видит их как обычные C++ классы и строит граф наследования.
# ----------------------------------------------------------------------------

ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = YES
EXPAND_AS_DEFINED      = UCLASS USTRUCT UENUM UPROPERTY UFUNCTION UINTERFACE GENERATED_BODY GENERATED_UCLASS_BODY GENERATED_USTRUCT_BODY

PREDEFINED             = "UCLASS()=" \
                         "UCLASS(...)=" \
                         "USTRUCT()=" \
                         "USTRUCT(...)=" \
                         "UENUM()=" \
                         "UENUM(...)=" \
                         "UPROPERTY()=" \
                         "UPROPERTY(...)=" \
                         "UFUNCTION()=" \
                         "UFUNCTION(...)=" \
                         "UINTERFACE()=" \
                         "UINTERFACE(...)=" \
                         "GENERATED_BODY()=" \
                         "GENERATED_UCLASS_BODY()=" \
                         "GENERATED_USTRUCT_BODY()=" \
                         "GENERATED_UENUM_BODY()=" \
                         "UE_API=" \
                         "OMNIBUNKER_API=" \
                         "FORCEINLINE=inline" \
                         "DEFINE_LOG_CATEGORY_STATIC(...)=" \
                         "DEFINE_LOG_CATEGORY(...)=" \
                         "DECLARE_LOG_CATEGORY_EXTERN(...)=" \
                         "UE_NODISCARD=" \
                         "FUNC_DECL=" \
                         "VIRTUAL=virtual" \
                         "ABSTRACT=" \
                         "OVERRIDE=override" \
                         "FINAL=final" \
                         "TArray=std::vector" \
                         "TMap=std::map" \
                         "TSet=std::set" \
                         "TObjectPtr=std::shared_ptr" \
                         "TSubclassOf=class" \
                         "TSoftObjectPtr=class" \
                         "TWeakObjectPtr=std::weak_ptr" \
                         "TSharedPtr=std::shared_ptr" \
                         "TSharedRef=std::shared_ptr" \
                         "TUniquePtr=std::unique_ptr" \
                         "TOptional=std::optional" \
                         "TEXT(x)=x"

SKIP_FUNCTION_MACROS   = YES

